# 定义变量
# 数据库 ROOT 角色的用户名、密码
POSTGRES_USER=xiangshan
POSTGRES_PASSWORD=xs@123456

# 数据库名称
POSTGRES_DB=n8n

# 非ROOT角色的用户名、密码
POSTGRES_NON_ROOT_USER=admin
POSTGRES_NON_ROOT_PASSWORD=xs@123456


# 设置时区
GENERIC_TIMEZONE=Asia/Shanghai


# Redis 配置
REDIS_HOST=rsshub-redis
REDIS_PORT=6379
REDIS_KEY_PREFIX=rsshub:

# RSSHub 配置
RSSHub_CONTAINER_NAME=rsshub-app
RSSHub_PORT=1200


# 添加你的其他环境变量